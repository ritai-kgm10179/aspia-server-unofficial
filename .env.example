# ==============================================================================
# 必填設定（部署前請先於 Arcane 的 .env 編輯器填入）
# ==============================================================================

# 供 Aspia Client 與 Host 連線至 Relay 的對外公開 IP 位址或網域名稱
ASPIA_RELAY_PUBLIC_ADDRESS=

# GitHub Container Registry 映像檔路徑前綴（請改為你的 GitHub 帳號或組織名稱）
IMAGE_PREFIX=ghcr.io/your-username/aspia-server-unofficial

# ==============================================================================
# 選填設定（Arcane 介面與映像檔更新管理）
# ==============================================================================

# 追蹤的映像檔標籤（設為 3 會自動接收所有 v3.x 版本與安全更新）
ASPIA_IMAGE_TAG=3

# Arcane 介面上顯示的自訂專案圖示網址
ASPIA_ICON_URL=https://raw.githubusercontent.com/your-username/aspia-server-unofficial/main/assets/aspia-icon.svg

# Arcane Auto-Updater 自動更新控制
ARCANE_UPDATER_ENABLED=true
# 偵測到新版映像檔後的延遲更新時數（小時）
ARCANE_UPDATER_DELAY=24

# ==============================================================================
# 選填設定（一般與日誌設定）
# ==============================================================================

TZ=Asia/Taipei
# 日誌詳細程度：0=追蹤 (trace)、1=資訊 (info)、2=警告 (warning)、3=錯誤 (error)、4=嚴重 (fatal)
ASPIA_LOG_LEVEL=1
# 將日誌輸出至標準輸出（stdout），方便於 Arcane Logs 即時檢視
ASPIA_LOG_TO_STDOUT=1
# 關閉容器內部檔案日誌，避免額外佔用磁碟空間
ASPIA_LOG_TO_FILE=0
# 是否於每次啟動時將環境變數同步寫入 .conf；設為 false 可完全保留手動修改的設定檔
ASPIA_MANAGE_CONFIG=true

# ==============================================================================
# 選填設定（Aspia Router）
# ==============================================================================

ASPIA_ROUTER_HOST_PORT=8061
ASPIA_ROUTER_CLIENT_PORT=8062
ASPIA_ROUTER_RELAY_PORT=8063
# 內建 STUN 伺服器：1=啟用、0=停用
ASPIA_ROUTER_STUN_ENABLED=1
ASPIA_ROUTER_STUN_PORT=8065
# 存取紀錄保留天數（1 至 365 天）
ASPIA_ROUTER_ACCESS_LOG_DAYS=45
# IP / CIDR 白名單（多筆請以半形逗號分隔，留空表示不限制）
ASPIA_ROUTER_HOST_WHITELIST=
ASPIA_ROUTER_CLIENT_WHITELIST=
ASPIA_ROUTER_RELAY_WHITELIST=

# ==============================================================================
# 選填設定（Aspia Relay）
# ==============================================================================

ASPIA_ROUTER_ADDRESS=aspia-router
# 使用 compose.yaml 內建的公開金鑰共用磁碟區時請留空；跨主機部署獨立 Relay 時再手動填入 relay.pub 內容
ASPIA_ROUTER_PUBLIC_KEY=
ASPIA_RELAY_PORT=8070
# 最大同時中繼連線數（1 至 1000）
ASPIA_RELAY_MAX_PEERS=100
# 連線閒置斷線逾時時間（1 至 60 分鐘）
ASPIA_RELAY_IDLE_TIMEOUT=5
